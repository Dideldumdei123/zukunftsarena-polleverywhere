<?xml version="1.0" encoding="UTF-8"?>
<!--
  PowerPoint Content Add-in: rendert eine eigene Webseite direkt auf der Folie.

  ContentApp (nicht TaskPaneApp) ist der Typ, der IM Dokument landet statt in
  einer Seitenleiste. Genau dieser Mechanismus wird auch vom Poll-Everywhere-
  Add-in benutzt - nur ist die Seite hier unsere eigene, also gibt es keine
  fremden Bedienelemente, die man nachtraeglich verstecken muesste.

  Installation: siehe install-mac.sh
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="ContentApp">

  <Id>5B84CF6D-1ABC-4622-86A8-0B84F2045425</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Zukunftsarena</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Zukunftsarena Live" />
  <Description DefaultValue="Zeigt die Live-Umfrageergebnisse direkt auf der Folie." />
  <IconUrl DefaultValue="https://dideldumdei123.github.io/zukunftsarena-polleverywhere/addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://dideldumdei123.github.io/zukunftsarena-polleverywhere/addin/icon-64.png" />
  <SupportUrl DefaultValue="https://dideldumdei123.github.io/zukunftsarena-polleverywhere/" />

  <AppDomains>
    <AppDomain>https://dideldumdei123.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://dideldumdei123.github.io/zukunftsarena-polleverywhere/addin/live.html" />
    <RequestedWidth>1000</RequestedWidth>
    <RequestedHeight>600</RequestedHeight>
  </DefaultSettings>

  <Permissions>Restricted</Permissions>

  <!-- false: bei Netzproblemen lieber leer als ein eingefrorenes altes
       Ergebnis, das aussieht wie ein aktuelles. -->
  <AllowSnapshot>false</AllowSnapshot>
</OfficeApp>
